# EduGuard UAE - environment configuration (copy to .env and fill in)
# No secrets are required to run the MVP. All embeddings are local.

# LLM backend: "ollama" (default, local) or "openai"
EDUGUARD_LLM_BACKEND=ollama

# Ollama settings (used when EDUGUARD_LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI settings (used when EDUGUARD_LLM_BACKEND=openai)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ChromaDB persistence directory
CHROMA_DB_PATH=./kb/chroma_db
